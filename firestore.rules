rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'lipinsky2033@gmail.com' ||
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'name', 'isAdmin']) &&
        data.id is string && data.id.size() <= 128 &&
        data.email is string && data.email.size() <= 128 &&
        data.name is string && data.name.size() <= 100 &&
        data.isAdmin is bool &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 30)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name']) &&
        data.id is string && data.id.size() <= 128 &&
        data.ownerId is string && data.ownerId.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        (!('filesCount' in data) || data.filesCount is number) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Test connection endpoint
    match /test/connection {
      allow read: if true;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data) && request.resource.data.id == userId;
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidUser(request.resource.data) && request.resource.data.id == userId;
      allow delete: if isAdmin();
    }

    // User projects
    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(projectId) && request.resource.data.ownerId == request.auth.uid && isValidProject(request.resource.data);
      allow update: if isSignedIn() && isValidId(projectId) && (resource.data.ownerId == request.auth.uid || isAdmin()) && isValidProject(request.resource.data) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && isValidId(projectId) && (resource.data.ownerId == request.auth.uid || isAdmin());
    }
  }
}
